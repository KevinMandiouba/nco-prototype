
# ==========================================
# Vivado
# ==========================================

# Generated Vivado project (created by scripts/create_project.tcl)
build/

# Files Vivado drops in whatever folder it is launched from
.Xil/
*.jou
*.log
*.str

# Safety net in case a project gets created outside build/
*.cache/
*.runs/
*.sim/
*.gen/
*.hw/
*.ip_user_files/
*.xpr

# ==========================================
# Simulation (GHDL, cocotb, Vivado)
# ==========================================

# Simulation directories
xsim.dir/
sim_build/

# Waveform files
*.wdb
*.vcd
*.ghw
*.fst

# GHDL compilation and elaboration artifacts
*.o
*.cf
e~*.lst

# GHDL executables (specific generated binary)
tb/nco/nco

# cocotb test results
results.xml
compile.log

# ==========================================
# Python
# ==========================================

__pycache__/
*.pyc
*.pyo

# Python virtual environments
.venv/
venv/

# Python testing
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Editors
# ==========================================

*.swp
*.swo
.vscode/*.log

# ==========================================
# Operating system
# ==========================================

.DS_Store
Thumbs.db
